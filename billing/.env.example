# Set these only on an isolated protected Preview; production is unconditionally blocked.
MEDICEA_MEMBERSHIP_PREVIEW=false
MEDICEA_MEMBERSHIP_ORIGIN=https://your-protected-preview.vercel.app
MEDICEA_MEMBERSHIP_AUTH_URL=
MEDICEA_MEMBERSHIP_AUTH_PUBLISHABLE_KEY=
MEDICEA_BILLING_DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PERSONAL_MONTHLY_PRICE_ID=
STRIPE_PERSONAL_ANNUAL_PRICE_ID=
STRIPE_PERSONAL_7_DAY_PRICE_ID=
STRIPE_PERSONAL_14_DAY_PRICE_ID=
STRIPE_PERSONAL_30_DAY_PRICE_ID=

# Google Play licence testing only; production stays disabled.
MEDICEA_GOOGLE_PLAY_TEST=false
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_PRIVATE_KEY=
GOOGLE_PLAY_ACCOUNT_SECRET=
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_EMAIL=
GOOGLE_PLAY_RECONCILE_SECRET=
# Set signing variables outside source control; use an absolute keystore path.
MEDICEA_KEYSTORE_PATH=
MEDICEA_KEYSTORE_PASSWORD=
MEDICEA_KEY_ALIAS=
MEDICEA_KEY_PASSWORD=

# Verified owner account for the complimentary-access manager (Preview only).
MEDICEA_MEMBERSHIP_ADMIN_EMAIL=
